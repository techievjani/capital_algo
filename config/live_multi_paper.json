{
  "mode": "paper",
  "poll_seconds": 20,
  "lookback_minutes": 1500,
  "state_path": "runtime/live_multi_paper_state.json",
  "log_directory": "runtime/logs",
  "strategy_groups": [
    {
      "name": "forex_pullback_core3",
      "strategy_kind": "forex_pullback",
      "symbols": ["GBPJPY", "EURJPY", "EURUSD"],
      "strategy_config": "config/strategies/forex_pullback_london_open.json",
      "require_spread": true
    },
    {
      "name": "btc_gold_hybrid",
      "strategy_kind": "asset_hybrid",
      "symbols": ["BTCUSD", "GOLD"],
      "strategy_config": "config/strategies/btc_breakout_gold_mean_reversion.json"
    }
  ],
  "order_execution": {
    "enabled": false,
    "allow_live_orders": false
  },
  "shutdown": {
    "on_stop": "stop_new_entries"
  },
  "paper_account": {
    "starting_balance": 10000.0,
    "currency": "USD"
  },
  "trailing_stop": {
    "enabled": true,
    "activation_r": 0.5,
    "distance_r": 0.5
  }
}
